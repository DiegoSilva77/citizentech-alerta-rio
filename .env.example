# ===========================================================================
# Alerta Rio - exemplo de configuração
# Copie este arquivo para ".env" e troque os valores. O .env NUNCA vai pro Git.
# Para gerar chaves fortes:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ===========================================================================

# --- Banco de dados MySQL (usuário da APLICAÇÃO, não o root) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alerta_rio
DB_USER=alerta_app
DB_PASSWORD=troque-por-uma-senha-forte

# --- Segurança ---
# Chave do operador (Defesa Civil) para cadastrar/editar/excluir pela API
API_KEY_OPERADOR=troque-por-uma-chave-com-32-caracteres
# Segredo compartilhado entre sensores e servidor para assinar leituras (HMAC)
SENSOR_HMAC_SECRET=troque-por-outro-segredo-com-32-caracteres

# --- Servidor UDP dos sensores ---
UDP_HOST=127.0.0.1
UDP_PORT=5005

# --- Cidade monitorada (usada na previsão da Open-Meteo e no mapa) ---
CIDADE_NOME=Porto Alegre - RS
CIDADE_LAT=-30.0346
CIDADE_LON=-51.2177

# --- Aplicação ---
FLASK_PORT=5000
FLASK_DEBUG=false
LOG_ARQUIVO=logs/alerta_rio.log
